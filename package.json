{
  "name": "tr-equity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "embed": "node scripts/embed-static.mjs",
    "predev": "npm run embed",
    "dev": "wrangler dev",
    "deploy": "bash scripts/deploy.sh",
    "pretypecheck": "npm run embed",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply tr-equity --local",
    "db:migrate:remote": "wrangler d1 migrations apply tr-equity --remote"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "lightweight-charts": "^4.2.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.147.0"
  }
}
